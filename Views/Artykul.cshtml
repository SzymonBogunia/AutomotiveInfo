@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.NewsPage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models

@{
    Layout = "_Layout.cshtml";

    // articleTitle is mandatory on the document type — no node-name fallback needed.
    var displayTitle = Model.ArticleTitle;
    ViewBag.Title = displayTitle;

    var authorNode = Model.Author as ContentModels.Author;

    var tagNode = Model.Tag as ContentModels.Tag;

    var mainImage = Model.MainImage as MediaWithCrops;
}



<article class="container mx-auto px-4 py-12 max-w-4xl">
    <div class="flex flex-wrap items-center gap-4 text-sm text-slate-400 mb-4">
        @if (Model.PublishDate != default)
        {
            <time datetime="@Model.PublishDate.ToString("yyyy-MM-dd")">
                📅 @Model.PublishDate.ToString("dd.MM.yyyy")
            </time>
        }

        @if (authorNode != null)
        {
            <span class="font-medium text-slate-300">✍️ @authorNode.FirstName @authorNode.SecondName</span>
        }

        @if (tagNode != null)
        {
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-500/10 text-red-400 border border-red-500/20">
                #@tagNode.TagName
            </span>
        }
    </div>

    <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-8 leading-tight">
        @displayTitle
    </h1>


    @if (mainImage != null)
    {
        <div class="mb-12 overflow-hidden rounded-3xl border border-slate-800/80 shadow-2xl bg-slate-900">
            <picture>
                @* desktop *@
                <source type="image/webp"
                        media="(min-width: 768px)"
                        srcset="@mainImage.GetCropUrl(width: 1200, height: 500, imageCropMode: ImageCropMode.Crop, furtherOptions: "&format=webp") 1200w,
                                @mainImage.GetCropUrl(width: 800, height: 333, imageCropMode: ImageCropMode.Crop, furtherOptions: "&format=webp") 800w"
                        sizes="(min-width: 1024px) 896px, 100vw" />

                @* mobile *@
                <source type="image/webp"
                        media="(max-width: 767px)"
                        srcset="@mainImage.GetCropUrl(width: 640, height: 400, imageCropMode: ImageCropMode.Crop, furtherOptions: "&format=webp") 640w,
                                @mainImage.GetCropUrl(width: 400, height: 250, imageCropMode: ImageCropMode.Crop, furtherOptions: "&format=webp") 400w"
                        sizes="100vw" />

                @* basic *@
                <img src="@mainImage.GetCropUrl(width: 800, height: 333, imageCropMode: ImageCropMode.Crop)"
                     alt="@displayTitle"
                     loading="eager"
                     class="w-full h-auto block" />
            </picture>
        </div>
    }
    @if (Model.Components != null && Model.Components.Any())
    {
        <div class="space-y-12 border-t border-slate-800/60 pt-12">
            @Html.GetBlockListHtml(Model.Components)
        </div>
    }
</article>