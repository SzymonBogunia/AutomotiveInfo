@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.ContentPage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions

@{
    Layout = "_Layout.cshtml";
    ViewBag.Title = Model.Heading ?? Umbraco.GetDictionaryValueOrDefault("General_PageTitleFallback", "Strona Informacyjna");
}
}

<section class="py-16 md:py-24 border-b border-slate-800 bg-slate-950/40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight mb-6">
            @Model.Heading
        </h1>

        @if (!string.IsNullOrEmpty(Model.Lead))
        {
            <p class="text-lg md:text-xl text-slate-400 leading-relaxed max-w-4xl mx-auto">
                @Model.Lead
            </p>
        }
    </div>
</section>

<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    @if (Model.Components != null && Model.Components.Any())
    {
        <div class="space-y-16">
            @Html.GetBlockListHtml(Model.Components)
        </div>
    }
</section>