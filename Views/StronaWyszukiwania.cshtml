@using Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<AutomotiveInfo.Search.SearchViewModel>

@{
    Layout = "_Layout.cshtml";

    // heading/lead come from the basePage composition (editor-controlled, per culture);
    // heading is mandatory there, so the dictionary value is only a safety net.
    var page = Model.Unwrap() as IBasePage;
    var heading = string.IsNullOrWhiteSpace(page?.Heading)
        ? Umbraco.GetDictionaryValueOrDefault("Search_Title", "Wyszukiwarka artykułów")
        : page!.Heading;
    var lead = page?.Lead;

    ViewBag.Title = heading;

    var results = Model.Results;
    var encodedQuery = Uri.EscapeDataString(Model.Query);

    string BuildUrl(string? tag, int page)
    {
        var url = $"{Model.Url()}?q={encodedQuery}";
        if (!string.IsNullOrEmpty(tag))
        {
            url += $"&tag={Uri.EscapeDataString(tag)}";
        }
        return page > 1 ? url + $"&page={page}" : url;
    }
}

@* Search result pages are an infinite, low-value crawl space — keep robots out. *@
@section Head {
    <meta name="robots" content="noindex" />
}

<div class="max-w-4xl mx-auto px-4 py-12 text-white">
    <h1 class="text-3xl font-bold mb-3">@heading</h1>

    @if (!string.IsNullOrWhiteSpace(lead))
    {
        <p class="text-slate-400 mb-8">@lead</p>
    }

    <form action="@Model.Url()" method="get" role="search" class="mb-6 flex gap-4">
        <label for="search-query" class="sr-only">@Umbraco.GetDictionaryValueOrDefault("Search_Placeholder", "Wpisz frazę lub tag...")</label>
        <input type="search" id="search-query" name="q" value="@Model.Query"
               placeholder="@Umbraco.GetDictionaryValueOrDefault("Search_Placeholder", "Wpisz frazę lub tag...")"
               class="flex-1 bg-slate-900 text-white border border-slate-700 rounded-lg px-4 py-3 focus:outline-none focus:border-red-500" />
        @* Keep the active tag filter when submitting a new phrase. *@
        @if (!string.IsNullOrEmpty(Model.Tag))
        {
            <input type="hidden" name="tag" value="@Model.Tag" />
        }
        <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-medium px-6 py-3 rounded-lg transition-colors">
            @Umbraco.GetDictionaryValueOrDefault("Search_SubmitButton", "Szukaj")
        </button>
    </form>

    @* Tag facet: makes tags discoverable instead of requiring "#tag" syntax. *@
    @if (Model.TagFacets.Any())
    {
        <nav class="mb-10 flex flex-wrap items-center gap-2" aria-label="@Umbraco.GetDictionaryValueOrDefault("Search_FilterByTag", "Filtruj po tagu")">
            <span class="text-xs uppercase tracking-wider text-slate-500 mr-1">@Umbraco.GetDictionaryValueOrDefault("Search_FilterByTag", "Filtruj po tagu")</span>

            @if (!string.IsNullOrEmpty(Model.Tag))
            {
                <a href="@BuildUrl(null, 1)" class="px-3 py-1 rounded-full text-xs font-semibold border border-slate-700 text-slate-300 hover:border-slate-500 transition-colors">
                    × @Umbraco.GetDictionaryValueOrDefault("Search_ClearTag", "Wyczyść filtr")
                </a>
            }

            @foreach (var facet in Model.TagFacets)
            {
                var isActive = string.Equals(facet.Name, Model.Tag, StringComparison.OrdinalIgnoreCase);
                <a href="@BuildUrl(isActive ? null : facet.Name, 1)"
                   aria-current="@(isActive ? "true" : null)"
                   class="@(isActive
                            ? "px-3 py-1 rounded-full text-xs font-semibold bg-red-600 text-white"
                            : "px-3 py-1 rounded-full text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-colors")">
                    #@facet.Name <span class="opacity-60">@facet.Count</span>
                </a>
            }
        </nav>
    }

    @if (results is not null)
    {
        <p class="text-slate-400 mb-6" role="status">
            @string.Format(Umbraco.GetDictionaryValueOrDefault("Search_ResultsFoundPrefix", "Znaleziono {0} artykułów dla frazy:"), results.TotalResults)
            @if (!string.IsNullOrEmpty(Model.Query))
            {
                <span class="text-white">"@Model.Query"</span>
            }
            @if (!string.IsNullOrEmpty(Model.Tag))
            {
                <span class="text-red-400">#@Model.Tag</span>
            }
        </p>

        if (results.Items.Any())
        {
            <div class="space-y-6">
                @foreach (var hit in results.Items)
                {
                    <article class="bg-slate-900 border border-slate-800 rounded-xl p-6 transition hover:border-slate-700">
                        <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 mb-2">
                            <time datetime="@hit.PublishDate.ToString("yyyy-MM-dd")">@hit.PublishDate.ToString("d")</time>
                            @if (!string.IsNullOrEmpty(hit.TagName))
                            {
                                <span class="px-2 py-0.5 rounded-full font-semibold bg-red-500/10 text-red-400 border border-red-500/20">#@hit.TagName</span>
                            }
                        </div>
                        <h2 class="text-xl font-bold mb-3">
                            <a href="@hit.Url" class="hover:text-red-500 transition-colors">@hit.Title</a>
                        </h2>
                        <a href="@hit.Url" class="text-red-500 hover:underline text-sm font-semibold">@Umbraco.GetDictionaryValueOrDefault("Search_ReadArticle", "Czytaj artykuł →")</a>
                    </article>
                }
            </div>

            if (results.TotalPages > 1)
            {
                var current = results.PageNumber;
                var total = results.TotalPages;
                var windowStart = Math.Max(1, current - 2);
                var windowEnd = Math.Min(total, current + 2);

                <nav class="flex flex-wrap gap-2 mt-8 justify-center items-center" aria-label="Pagination">
                    @if (current > 1)
                    {
                        <a href="@BuildUrl(Model.Tag, current - 1)" rel="prev" aria-label="«" class="px-4 py-2 rounded-lg font-medium bg-slate-800 text-slate-300 hover:bg-slate-700">«</a>
                    }

                    @if (windowStart > 1)
                    {
                        <a href="@BuildUrl(Model.Tag, 1)" class="px-4 py-2 rounded-lg font-medium bg-slate-800 text-slate-300 hover:bg-slate-700">1</a>
                        @if (windowStart > 2)
                        {
                            <span class="px-2 text-slate-500" aria-hidden="true">…</span>
                        }
                    }

                    @for (var i = windowStart; i <= windowEnd; i++)
                    {
                        if (i == current)
                        {
                            <span aria-current="page" class="px-4 py-2 rounded-lg font-medium bg-red-600 text-white">@i</span>
                        }
                        else
                        {
                            <a href="@BuildUrl(Model.Tag, i)" class="px-4 py-2 rounded-lg font-medium bg-slate-800 text-slate-300 hover:bg-slate-700">@i</a>
                        }
                    }

                    @if (windowEnd < total)
                    {
                        @if (windowEnd < total - 1)
                        {
                            <span class="px-2 text-slate-500" aria-hidden="true">…</span>
                        }
                        <a href="@BuildUrl(Model.Tag, total)" class="px-4 py-2 rounded-lg font-medium bg-slate-800 text-slate-300 hover:bg-slate-700">@total</a>
                    }

                    @if (current < total)
                    {
                        <a href="@BuildUrl(Model.Tag, current + 1)" rel="next" aria-label="»" class="px-4 py-2 rounded-lg font-medium bg-slate-800 text-slate-300 hover:bg-slate-700">»</a>
                    }
                </nav>
            }
        }
        else
        {
            <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-8 text-center text-slate-400">
                @Umbraco.GetDictionaryValueOrDefault("Search_NoResults", "Brak artykułów spełniających kryteria wyszukiwania.")
            </div>
        }
    }
</div>