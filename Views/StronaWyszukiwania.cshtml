@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.SearchPage>
@inject AutomotiveInfo.Search.IArticleSearchService ArticleSearchService

@{
    Layout = "_Layout.cshtml";

    string searchQuery = Context.Request.Query["q"].ToString().Trim();
    int pageSize = 5;
    int pageNumber = int.TryParse(Context.Request.Query["page"], out int p) && p > 0 ? p : 1;

    var result = ArticleSearchService.Search(searchQuery, pageNumber, pageSize);
}

<div class="max-w-4xl mx-auto px-4 py-12 text-white">
    <h1 class="text-3xl font-bold mb-8">@Umbraco.GetDictionaryValueOrDefault("Search_Title", "Wyszukiwarka artykułów")</h1>

    <form action="@Model.Url()" method="get" class="mb-10 flex gap-4">
        <input type="text" name="q" value="@searchQuery"
               placeholder="@Umbraco.GetDictionaryValueOrDefault("Search_Placeholder", "Wpisz frazę lub tag...")"
               class="flex-1 bg-slate-900 text-white border border-slate-700 rounded-lg px-4 py-3 focus:outline-none focus:border-red-500" />
        <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-medium px-6 py-3 rounded-lg transition-colors">
            @Umbraco.GetDictionaryValueOrDefault("Search_SubmitButton", "Szukaj")  
        </button>
    </form>

    @if (!string.IsNullOrWhiteSpace(searchQuery))
    {
        <p class="text-slate-400 mb-6">@Html.Raw(string.Format(Umbraco.GetDictionaryValueOrDefault("Search_ResultsFoundPrefix", "Znaleziono {0} artykułów dla frazy:"), $"<strong>{result.TotalResults}</strong>")) <span class="text-white">"@searchQuery"</span></p>

        if (result.Items.Any())
        {
            <div class="space-y-6">
                @foreach (var article in result.Items)
                {
                    string title = article.HasValue("articleTitle") ? article.Value<string>("articleTitle")!
                    : article.HasValue("title") ? article.Value<string>("title")!
                    : article.Name!;

                    <article class="bg-slate-900 border border-slate-800 rounded-xl p-6 transition hover:border-slate-700">
                        <h2 class="text-xl font-bold mb-2">
                            <a href="@article.Url()" class="hover:text-red-500 transition-colors">@title</a>
                        </h2>
                        @if (article.HasValue("lead") || article.HasValue("summary"))
                        {
                            <p class="text-slate-400 text-sm mb-3">
                                @(article.HasValue("lead") ? article.Value("lead") : article.Value("summary"))
                            </p>
                        }
                        <a href="@article.Url()" class="text-red-500 hover:underline text-sm font-semibold">@Umbraco.GetDictionaryValueOrDefault("Search_ReadArticle", "Czytaj artykuł →")</a>
                    </article>
                }
            </div>

            if (result.TotalPages > 1)
            {
                <div class="flex gap-2 mt-8 justify-center">
                    @for (int i = 1; i <= result.TotalPages; i++)
                    {
                        var activeClass = i == pageNumber ? "bg-red-600 text-white" : "bg-slate-800 text-slate-300 hover:bg-slate-700";
                        <a href="@Model.Url()?q=@searchQuery&page=@i" class="px-4 py-2 rounded-lg font-medium @activeClass">@i</a>
                    }
                </div>
            }
        }
        else
        {
            <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-8 text-center text-slate-400">
                @Umbraco.GetDictionaryValueOrDefault("Search_NoResults", "Brak artykułów spełniających kryteria wyszukiwania.")
            </div>
        }
    }
</div>