@using System.Globalization
@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Extensions
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@inject Umbraco.Cms.Core.PublishedCache.IDefaultCultureAccessor DefaultCultureAccessor

@{
    var currentContent = Umbraco.AssignedContentItem;

    // wrapper
    var globalSettings = currentContent.AncestorOrSelf<ContentModels.WebsiteContainer>();

    // home page
    var homePage = globalSettings?.FirstChild<ContentModels.FrontPage>() ?? currentContent.Root().FirstChild<ContentModels.FrontPage>();

    // url eng/pl
    var homePageUrl = homePage?.Url() ?? "/";

    // pobieramy opublikowane dzieci strony głównej
    var navPages = homePage?.Children().Where(x => x.IsVisible()) ?? Enumerable.Empty<IPublishedContent>();

    // dane z wrappera
    var logo = globalSettings?.Logo;
    var footerLinks = globalSettings?.FooterLinks;
    var copyrightText = globalSettings?.CopyrightText;

    // --- SEO (kompozycja seoSettings przez wygenerowany interfejs ISeoSettings) ---
    // Tytuł: SEO Title redaktora > tytuł ustawiony przez widok > nazwa węzła.
    var seo = currentContent as ISeoSettings;
    var fallbackTitle = (ViewBag.Title as string) ?? currentContent.Name;
    var pageTitle = string.IsNullOrWhiteSpace(seo?.SeoTitle) ? fallbackTitle : seo!.SeoTitle;
    var metaDescription = seo?.SeoDescription;
    var hideFromSearch = seo?.SeoToggle == true;

    var canonicalUrl = currentContent.Url(mode: UrlMode.Absolute);

    // hreflang: tylko kultury, w których ten węzeł jest opublikowany.
    var publishedCultures = currentContent.Cultures.Keys
        .Where(c => !string.IsNullOrEmpty(c))
        .Select(c => CultureInfo.GetCultureInfo(c).Name)
        .ToList();
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentCulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - AutomotiveInfo</title>

    @if (!string.IsNullOrWhiteSpace(metaDescription))
    {
        <meta name="description" content="@metaDescription" />
    }
    @if (hideFromSearch)
    {
        <meta name="robots" content="noindex,nofollow" />
    }
    <link rel="canonical" href="@canonicalUrl" />
    @if (publishedCultures.Count > 1)
    {
        foreach (var culture in publishedCultures)
        {
            <link rel="alternate" hreflang="@culture" href="@currentContent.Url(culture: culture, mode: UrlMode.Absolute)" />
        }
        <link rel="alternate" hreflang="x-default" href="@currentContent.Url(culture: DefaultCultureAccessor.DefaultCulture, mode: UrlMode.Absolute)" />
    }

    <script src="https://cdn.tailwindcss.com"></script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="bg-slate-900 text-slate-100 flex flex-col min-h-screen">

    <header class="border-b border-slate-800 bg-slate-950/80 backdrop-blur sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">

            <a href="@homePageUrl" class="flex items-center space-x-2 text-xl font-black tracking-tight text-white hover:text-red-500 transition-colors">
                @if (logo != null)
                {
                    <img src="@logo.Url()" alt="Logo" class="h-8 w-auto object-contain" />
                }
                else
                {
                    <span>🚗</span>
                    <span>AUTOMOTIVE<span class="text-red-500">INFO</span></span>
                }
            </a>

            <nav class="flex items-center space-x-8 text-sm font-medium">

                @* Dynamiczna nawigacja z drzewa *@
                @foreach (var navItem in navPages)
                {
                    var isActive = currentContent.IsAncestorOrSelf(navItem);
                    <a href="@navItem.Url()" class="@(isActive ? "text-red-500 font-bold border-b-2 border-red-500 pb-1" : "text-slate-300 hover:text-white transition-colors")">
                        @navItem.Name
                    </a>
                }
            </nav>
        </div>
    </header>
    @* breadcrumbs render *@
    @if (currentContent.Id != homePage?.Id)
    {
        var breadcrumbs = currentContent.Ancestors()
        .Where(x => globalSettings == null || x.Id != globalSettings.Id)
        .Reverse()
        .ToList();


        <div class="bg-slate-950/40 border-b border-slate-800/60 py-3">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <nav aria-label="Breadcrumb">
                    <ol class="inline-flex items-center space-x-1 md:space-x-2 text-xs font-medium text-slate-400">
                        @foreach (var crumb in breadcrumbs)
                        {
                            <li class="inline-flex items-center">
                                <a href="@crumb.Url()" class="hover:text-white transition-colors">
                                    @crumb.Name
                                </a>
                                <span class="mx-2 text-slate-600">/</span>
                            </li>
                        }
                        <li aria-current="page" class="text-red-400 font-semibold truncate">
                            @currentContent.Name
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    }

    <main class="flex-grow">
        @RenderBody()
    </main>

    <footer class="border-t border-slate-800 bg-slate-950 text-slate-400 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">

            <div class="text-sm">
                &copy; @DateTime.Now.Year @copyrightText
            </div>

            <div class="flex space-x-6 text-sm">
                @if (footerLinks != null && footerLinks.Any())
                {
                    foreach (var link in footerLinks)
                    {
                        <a href="@link.Url" target="@link.Target" class="hover:text-slate-200 transition-colors">@link.Name</a>
                    }
                }
            </div>
        </div>
    </footer>

</body>
</html>