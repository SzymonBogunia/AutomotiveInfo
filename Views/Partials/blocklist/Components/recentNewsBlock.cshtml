@using AutomotiveInfo.Models
@using AutomotiveInfo.Models.Blocks
@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem<ContentModels.RecentNewsBlock, ContentModels.BlockSettings>>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions
@inject AutomotiveInfo.News.INewsArticleService NewsArticleService

@{
    if (Model.Settings?.HideBlockElement ?? false) { return; }

    // Articles come from the shared, cached, culture-aware service — the same source
    // the news list and the API use, so ordering and mapping can never drift.
    var tagName = (Model.Content.TagFilter as ContentModels.Tag)?.TagName;
    var culture = NewsArticleService.ResolveCulture(null)!;
    var articles = (NewsArticleService.GetArticles(culture) ?? Array.Empty<NewsArticleDto>())
        .Where(a => tagName is null || string.Equals(a.Tag, tagName, StringComparison.OrdinalIgnoreCase))
        .Take(3)
        .ToList();

    var viewModel = new RecentNewsViewModel(Model.Content.BlockTitle, Model.Content.Source?.Url(), articles, BlockViewModelFactory.ToChrome(Model.Settings));
}
@await Html.PartialAsync("components/_recentNews", viewModel)
