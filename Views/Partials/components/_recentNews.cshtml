@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<AutomotiveInfo.Models.Blocks.RecentNewsViewModel>

<div id="@Model.Chrome.AnchorId"
     style="@Model.Chrome.BackgroundStyle"
     class="max-w-6xl mx-auto @Model.Chrome.SpacingClasses @Model.Chrome.BackgroundPaddingClasses">
    @if (!string.IsNullOrEmpty(Model.Title))
    {
        <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl md:text-3xl font-extrabold text-white">@Model.Title</h2>
            @if (!string.IsNullOrEmpty(Model.ViewAllUrl))
            {
                <a href="@Model.ViewAllUrl" class="text-sm font-semibold text-red-500 hover:text-red-400 transition-colors">@Umbraco.GetDictionaryValueOrDefault("General_ViewAll", "Zobacz wszystkie →")</a>
            }
        </div>
    }

    @if (Model.Articles.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            @foreach (var article in Model.Articles)
            {
                @await Html.PartialAsync("components/_articleCard", article)
            }
        </div>
    }
    else
    {
        <div class="text-center py-12 bg-slate-900/40 rounded-2xl border border-slate-800/40">
            <span class="text-2xl mb-2 block" aria-hidden="true">🔍</span>
            <p class="text-sm text-slate-400 font-medium">@Umbraco.GetDictionaryValueOrDefault("News_NoFilterResults", "Brak wyników spełniających kryteria filtrowania.")</p>
        </div>
    }
</div>
