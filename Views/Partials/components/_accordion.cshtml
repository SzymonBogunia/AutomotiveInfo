@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<AutomotiveInfo.Models.Blocks.AccordionViewModel>

<div id="@Model.Chrome.AnchorId"
     style="@Model.Chrome.BackgroundStyle"
     class="max-w-6xl mx-auto @Model.Chrome.SpacingClasses @Model.Chrome.BackgroundPaddingClasses">
    @if (!string.IsNullOrEmpty(Model.Title))
    {
        <h2 class="text-2xl md:text-3xl font-extrabold text-white mb-8 tracking-tight text-center md:text-left">
            @Model.Title
        </h2>
    }

    @if (Model.Items.Any())
    {
        <div class="space-y-4">
            @foreach (var item in Model.Items)
            {
                <details class="group bg-slate-900 border border-slate-800/80 rounded-2xl overflow-hidden [&_summary::-webkit-details-marker]:hidden transition-all duration-300">
                    <summary class="flex items-center justify-between p-5 md:p-6 text-white font-bold cursor-pointer select-none hover:bg-slate-800/30 transition-colors focus:outline-none">
                        <span class="text-base md:text-lg pr-4">@item.Heading</span>
                        <span class="text-red-500 transition-transform duration-300 group-open:rotate-180 shrink-0" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                            </svg>
                        </span>
                    </summary>

                    @if (item.Content is not null && !string.IsNullOrEmpty(item.Content.ToHtmlString()))
                    {
                        <div class="p-5 md:p-6 border-t border-slate-800/60 text-slate-300 leading-relaxed prose prose-invert prose-sm max-w-none">
                            @item.Content
                        </div>
                    }
                </details>
            }
        </div>
    }
    else
    {
        <div class="text-center py-8 bg-slate-900/20 rounded-2xl border border-dashed border-slate-800">
            <p class="text-sm text-slate-500">@Umbraco.GetDictionaryValueOrDefault("Accordion_Empty", "Ten akordeon nie zawiera jeszcze żadnych pytań.")</p>
        </div>
    }
</div>
