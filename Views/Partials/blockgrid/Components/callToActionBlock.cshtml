@using AutomotiveInfo.Models.Blocks
@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem<ContentModels.CallToActionBlock, ContentModels.BlockSettings>>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;

@{
    if (Model.Settings?.HideBlockElement ?? false) { return; }
}
<div class="col-span-12 md:col-span-@Model.ColumnSpan">
    @await Html.PartialAsync("components/_cta", Model.Content.ToViewModel(Model.Settings))
</div>
