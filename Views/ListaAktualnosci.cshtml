@using AutomotiveInfo.Models
@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.NewsListPage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions
@inject AutomotiveInfo.News.INewsArticleService NewsArticleService

@{
    Layout = "_Layout.cshtml";
    // title is mandatory on the document type — no fallback needed.
    ViewBag.Title = Model.Title;

    // The same cached, culture-aware source the recent-news block and the API use.
    var culture = NewsArticleService.ResolveCulture(null)!;
    var articles = NewsArticleService.GetArticles(culture) ?? Array.Empty<NewsArticleDto>();
}

<div class="container mx-auto px-4 py-12 max-w-6xl">
    <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-12 text-center">
        @Model.Title
    </h1>

    @if (articles.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            @foreach (var article in articles)
            {
                @await Html.PartialAsync("components/_articleCard", article)
            }
        </div>
    }
    else
    {
        <div class="text-center py-16 bg-slate-900/50 rounded-2xl border border-slate-800/50">
            <p class="text-slate-400">@Umbraco.GetDictionaryValueOrDefault("News_NoResults", "Aktualnie brak opublikowanych artykułów.")</p>
        </div>
    }
</div>