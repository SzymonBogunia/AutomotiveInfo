<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
  </PropertyGroup>
  <!-- Backoffice extensions live in Client\<Name>\ (Vite) and build into App_Plugins\<Name>\,
       per the official "Vite package setup" guide. Deliberately NO entries here:
       App_Plugins/** is globbed into build + publish output by Umbraco's own MSBuild targets,
       and adding an explicit <Content Include> without CopyToPublishDirectory overrides that
       globbing and silently drops the file from `dotnet publish` (verified the hard way).
       The built output is committed, so the site runs without Node — see Client\README.md.
       The two lines below are the only concessions: the Web SDK globs **/*.json, which would
       otherwise publish package-lock.json and a second (dead) umbraco-package.json from
       Client\; and TypeScriptCompileBlocked keeps Visual Studio from compiling the .ts files
       itself alongside Vite, which the guide warns about. -->
  <PropertyGroup>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="Client\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="uSync" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>


  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <UserSecretsId>10fbf82f-a49d-4234-aaac-87eb7eb94964</UserSecretsId>
  </PropertyGroup>


</Project>
