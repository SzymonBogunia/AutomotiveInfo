<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="c350d716-b434-45f7-a645-6176f4fb7c2d" Alias="blockSettings" Level="2">
  <Info>
    <Name>Ustawienia bloku</Name>
    <Icon>icon-settings</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>Wspólne ustawienia prezentacji dla wszystkich bloków: widoczność, odstępy, kotwica i kolor tła.</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Nothing</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Komponenty</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>b1000000-0000-4000-8000-000000000003</Key>
      <Name>Identyfikator kotwicy</Name>
      <Alias>anchorId</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^[a-z0-9-]*$</Validation>
      <Description><![CDATA[Opcjonalne id do linkowania w obrębie strony (#kotwica). Tylko małe litery, cyfry i myślniki.]]></Description>
      <SortOrder>2</SortOrder>
      <Tab Alias="wygląd">Wygląd</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Dozwolone tylko małe litery, cyfry i myślniki.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>b1000000-0000-4000-8000-000000000004</Key>
