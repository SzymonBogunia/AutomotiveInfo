      <Value Culture="en"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "bc8cfc9b-08fe-4be1-8a61-49c6dedf32ba",
      "key": "a4013953-bf4f-4c32-8519-3c68dae6af26",
      "values": [
        {
          "alias": "componentText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EThe portal features articles related to purchasing new and used cars, guides on vehicle maintenance and servicing, and tips for reducing operating costs. A significant portion of the publications consist of car tests, model comparisons, and descriptions of modern safety systems and technological solutions used by manufacturers.\u003C/p\u003E\u003Cp\u003EAutomotive Info also covers topics related to electromobility, hybrid and electric cars, changes in road regulations, and automotive news. Thanks to regularly updated content, the portal is a valuable source of knowledge for both those planning to buy a car and drivers looking to expand their knowledge about vehicle operation.\u003C/p\u003E"
          }
        }
      ]
    },
    {
