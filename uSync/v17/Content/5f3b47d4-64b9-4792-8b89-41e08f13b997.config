  <Properties>
    <articleTitle>
      <Value Culture="en"><![CDATA[Premiere of the new Audi]]></Value>
      <Value Culture="pl-PL"><![CDATA[Premiera nowego Audi (zmiana)]]></Value>
    </articleTitle>
    <author>
      <Value><![CDATA[umb://document/1723c66d185843ae91e36aee09747a71]]></Value>
    </author>
    <components>
      <Value Culture="en"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "bc8cfc9b-08fe-4be1-8a61-49c6dedf32ba",
      "key": "a0c3315d-c0e5-432e-a891-b0667ef2fa8f",
      "values": [
        {
          "alias": "componentText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EAudi wants to fix what customers have been criticizing for years.\u003C/p\u003E\u003Cp\u003EThe future A4 is expected to be more than just another Audi with a new drivetrain. The Germans are announcing a significant change in the cabin, admitting that the build quality of recent models fell short of customer expectations. In practice, this means better materials, more physical buttons, and fewer functions crammed solely into the touchscreen.\u003C/p\u003E\u003Cp\u003EThis is an important statement, as many manufacturers have gone overboard with digitizing their interiors in recent years. A screen can look impressive, but when driving, physical controls often trump simplicity.\u003C/p\u003E"
          }
        }
      ]
    }
  ],
  "settingsData": [
    {
      "contentTypeKey": "c350d716-b434-45f7-a645-6176f4fb7c2d",
      "key": "967d8722-3cdc-40d9-a1bc-d3624837b005",
      "values": [
        {
          "alias": "hideBlockElement",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "0"
        }
      ]
    }
  ],
  "expose": [
    {
      "contentKey": "a0c3315d-c0e5-432e-a891-b0667ef2fa8f",
      "culture": null,
      "segment": null
    }
  ],
  "layout": {
    "Umbraco.BlockList": [
      {
        "contentKey": "a0c3315d-c0e5-432e-a891-b0667ef2fa8f",
